#============================ PROJECT FOLDER NAME (EDIT THIS FIELD) =============================================
# PROJECT FOLDER NAME: Enter a custom name for your project folder name created at path ~/OpenLane/design/project_scl_cp8d (Example: If the project name is project1, enter "project1").

export PROJECT_NAME=project1

#================================ DESIGN_NAME  (EDIT THIS  FIELD) ===============================================
# INPUT RTL NAME: The core filename of your input Verilog source file.
# NOTE: Omit the ".v" extension. (Example: If the file is "test.v", enter "test").

export DESIGN_NAME=test

#============================ DESIGN_TOP_CELL_NAME  (EDIT THIS  FIELD) ===========================================
# Enter top cell name of RTL design file name as created by the user 

export DESIGN_TOP_CELL_NAME=test_top

#============================ TESTBENCH_TOP_CELL_NAME  (EDIT THIS  FIELD) ========================================
# Input testbench file name as created by the user 
# NOTE: Omit the ".v" extension. (Example: If the file is "tb_test.v", enter "tb_test").

export TB_VERILOG_FILE=tb_test

#============================ DESIGN_TOP_CELL_NAME  (DO NOT EDIT THIS  FIELD) ====================================
# Enter top cell name of RTL design file name as created by the user 

export SYNTHESIS_NETLIST_NAME=${DESIGN_NAME}_sys.v

#============================ DESIGN DIRECTORY PATH (DO NOT EDIT THIS  FIELD) ===================================
# PROJECT DIRECTORY PATH: Enter a absolute project directory path.

export DESIGN_DIR=$OPENLANE_PATH/designs/project_scl_cp8d/$PROJECT_NAME

#================== ENVIRONMENT SUMMARY (DO NOT EDIT THIS  FIELD) ================================================
echo ""
echo "============================================================================"
echo " Please verify that the displayed path/variables match with actual settings."
echo "============================================================================"
echo ""
echo "================== DESIGN RELATED VARIABLES =============================="
echo " DESIGN_DIR               : $DESIGN_DIR"
echo " DESIGN_NAME              : $DESIGN_NAME.v"
echo " DESIGN_TOP_CELL_NAME     : $DESIGN_TOP_CELL_NAME"
echo " SYNTHESIS_NETLIST_NAME   : ${SYNTHESIS_NETLIST_NAME}"
echo ""
echo "================== SCL cp8d RELATED VARIABLES =============================="
echo " HOME:          $HOME"
echo " MY_DTECH_DIR_PATH        : $MY_DTECH_DIR_PATH"
echo " PDK_ROOT                 : $PDK_ROOT"
echo " PDK                      : $PDK"
echo " OPENLANE_PATH            :  $OPENLANE_PATH"
echo " KLAYOUT_PATH             : $KLAYOUT_PATH"
echo "============================================================================"
echo ""

#=========================================================================
#====== DO NOT EDIT THIS FILE FROM THIS LINE ONWORDS =====================
#=========================================================================

#--------------------- DO NOT EDIT THIS FIELD ----------------------------
# Enter Output File Name as desided by the user --------------------------

export OUTPUT_FILE=$DESIGN_DIR/2_iverilog_prelayout/tb_prelay_sim/$TB_VERILOG_FILE.vvp

#===== iverilog SIMULATION COMMAND (DO NOT EDIT) =========================

iverilog -gspecify -Tmax -o $OUTPUT_FILE \
$PDK_ROOT/$PDK/libs.ref/digital_cp8d/verilog/cp8d.v \
$DESIGN_DIR/1_RTL/$DESIGN_NAME.v \
$DESIGN_DIR/2_iverilog_prelayout/tb_prelay_sim/$TB_VERILOG_FILE.v

#===== VPP TO VCD  CONVERSION COMMAND (DO NOT EDIT) ======================

vvp $DESIGN_DIR/2_iverilog_prelayout/tb_prelay_sim/$TB_VERILOG_FILE.vvp 

#===== COMMAND TO OPEN GTK WAVE (DO NOT EDIT)  ===========================
 
gtkwave *.vcd &

#=========================== END =========================================
